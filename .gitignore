supabase/.temp/
supabase/.branches/

# Android / Capacitor / Gradle build output
app/android/app/build/
app/android/build/
app/android/.gradle/
app/android/local.properties
app/android/**/build/
*.apk
*.aab

# Editor/OS cruft
.DS_Store
Thumbs.db
