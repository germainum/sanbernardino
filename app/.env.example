# mock (default): reads packages/core's 6 prototype scenarios in-process, no backend needed.
# api: fetches the real Supabase backend (Phases 4-6) at VITE_API_BASE.
VITE_DATA_SOURCE=mock

# Only used when VITE_DATA_SOURCE=api.
VITE_API_BASE=http://127.0.0.1:54321/functions/v1
# Supabase anon key is a public key by design (safe to ship in a client bundle) — get it
# from `supabase status` for local dev, or the project's API settings once deployed.
VITE_SUPABASE_ANON_KEY=
