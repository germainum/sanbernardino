# Local secrets for `supabase functions serve` — copy to .env.local (already gitignored)
# and fill in real values. Production secrets are set separately via
# `supabase secrets set KEY=value --project-ref <ref>`.

CRON_SECRET=
DATA_SOURCE=mock

# Windy Webcams API v3 key (https://api.windy.com/webcams) — used only server-side by the
# webcam proxy function, never shipped to the client bundle.
WINDY_KEY=
